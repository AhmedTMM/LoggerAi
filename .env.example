# MongoDB
MONGODB_URI=mongodb://localhost:27017/aviation-intelligence

# Reducto API (Document Intelligence)
REDUCTO_API_KEY=your_reducto_api_key_here

# Firecrawl API (Web Intelligence)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# OpenRouter API (AI Safety Analysis)
# OpenRouter provides access to multiple AI models (Gemini, Claude, GPT, etc.)
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Resend API (Email Communication)
RESEND_API_KEY=your_resend_api_key_here

# Safety email recipient for AI analysis reports
SAFETY_EMAIL_RECIPIENT=your_email@example.com

# Google OAuth (Authentication)
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# NextAuth Configuration
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET=your_nextauth_secret_here
# Set this to your production URL
NEXTAUTH_URL=http://localhost:3001

# Server Configuration
PORT=3001
NODE_ENV=development
